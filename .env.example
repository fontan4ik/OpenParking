# ParkingUSA Environment Variables

# Database (optional - app works with GeoJSON files without it)
DATABASE_URL=postgresql://parking:parking@localhost:5432/parkingusa?schema=public
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=parkingusa
POSTGRES_PORT=5432

# Map style (free OpenFreeMap or MapTiler)
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# Routing (server-side Valhalla boundary for /api/route)
VALHALLA_URL=http://127.0.0.1:8002

# OpenCage Geocoding API (server-side; keep real key in .env.local only)
# IMPORTANT: Since next.config.js is in apps/frontend/, Next.js reads .env* files
# from apps/frontend/ directory, not from root. Put your key in apps/frontend/.env.local:
#   OPENCAGE_API_KEY=your_key_here
# Get a free API key at https://opencagedata.com/pricing
OPENCAGE_API_KEY=

# Zrok external access (optional; keep real tokens in .env.local or shell only)
ZROK_PATH=C:\zrok\zrok2.exe
ZROK_ENABLE_TOKEN=
ZROK_SHARE_TARGET=localhost:3000
