{
  "name": "openparking",
  "version": "1.0.0",
  "private": true,
  "description": "OpenParking — Open Parking Intelligence",
  "scripts": {
    "dev": "next dev apps/frontend",
    "dev:public": "next dev apps/frontend -H 0.0.0.0 -p 3000",
    "build": "next build apps/frontend",
    "start": "next start apps/frontend",
    "lint": "next lint apps/frontend",
    "check:local": "npm run research:validate && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit --pretty false",
    "data:refresh:miami": "npm run fetch:miami-beach && npm run fetch:miami-beach:arcgis",
    "prisma": "prisma --schema apps/backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema apps/backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/backend/prisma/schema.prisma",
    "db:seed": "npm run import:sf",
    "import:sf": "node apps/backend/scripts/import_sf_to_db.mjs",
    "fetch:osm:miami": "python apps/backend/scripts/fetch_osm_parking.py --city miami --rows 4 --cols 4 --output data/miami_parking_osm.geojson",
    "fetch:osm:miami-beach": "python apps/backend/scripts/fetch_osm_parking.py --city miami_beach --rows 8 --cols 8 --output data/miami_beach_parking_osm.geojson",
    "audit:osm-coverage:miami-beach": "node apps/backend/scripts/audit_osm_parking_coverage.mjs --coverage=data/miami_parking_osm.geojson --coverage=data/miami_beach_osm_basemap_candidates.geojson --write-missing-candidates=data/miami_beach_osm_basemap_candidates.geojson",
    "sanitize:osm-candidates:miami-beach": "node apps/backend/scripts/audit_osm_parking_coverage.mjs --sanitize-existing-candidates --candidate-file=data/miami_beach_osm_basemap_candidates.geojson",
    "fetch:osm:sf": "python apps/backend/scripts/fetch_osm_parking.py --city sf --rows 4 --cols 4 --output data/sf_parking_osm.geojson",
    "fetch:pbf:florida": "node apps/backend/scripts/download_geofabrik_pbf.mjs --region=florida",
    "fetch:pbf:florida:dry-run": "node apps/backend/scripts/download_geofabrik_pbf.mjs --region=florida --dry-run",
    "fetch:boundary:miami:dry-run": "node apps/backend/scripts/fetch_census_boundary_geojson.mjs --boundary=miami-place --dry-run",
    "fetch:boundary:miami": "node apps/backend/scripts/fetch_census_boundary_geojson.mjs --boundary=miami-place",
    "fetch:boundary:miami-dade:dry-run": "node apps/backend/scripts/fetch_census_boundary_geojson.mjs --boundary=miami-dade-county --dry-run",
    "fetch:boundary:miami-dade": "node apps/backend/scripts/fetch_census_boundary_geojson.mjs --boundary=miami-dade-county",
    "fetch:miami-beach": "node apps/backend/scripts/fetch_miami_beach_parking_wpgmza.mjs",
    "fetch:miami-beach:arcgis": "node apps/backend/scripts/fetch_miami_beach_parking_arcgis.mjs",
    "import:osm:sf": "node apps/backend/scripts/import_osm_with_osmtogeojson.mjs",
    "import:osm:sf:db": "node apps/backend/scripts/import_osm_with_osmtogeojson.mjs --db",
    "import:osm:pbf": "node apps/backend/scripts/import_pbf_with_osm2pgsql.mjs",
    "import:osm:pbf:dry-run": "node apps/backend/scripts/import_pbf_with_osm2pgsql.mjs --dry-run",
    "import:osm:pbf:florida:dry-run": "node apps/backend/scripts/import_pbf_with_osm2pgsql.mjs --input=data/osm/florida-latest.osm.pbf --schema=osm_raw --dry-run",
    "import:osm:pbf:florida:parking:dry-run": "node apps/backend/scripts/import_pbf_with_osm2pgsql.mjs --input=data/osm/florida-latest.osm.pbf --schema=osm_raw --flex=apps/backend/scripts/osm2pgsql_parking.lua --dry-run",
    "import:osm:pbf:florida:parking:docker": "docker compose --profile tools run --rm osm2pgsql",
    "normalize:osm:pbf": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs",
    "normalize:osm:pbf:dry-run": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --dry-run",
    "normalize:osm:pbf:miami:dry-run": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami --state=FL --bbox=25.7090,-80.3198,25.8558,-80.1395 --dry-run",
    "normalize:osm:pbf:miami": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami --state=FL --bbox=25.7090,-80.3198,25.8558,-80.1395",
    "normalize:osm:pbf:miami:boundary:dry-run": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami --state=FL --bbox=25.7090,-80.3198,25.8558,-80.1395 --boundary-geojson=data/boundaries/miami_place_boundary.geojson --dry-run",
    "normalize:osm:pbf:miami:boundary": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami --state=FL --bbox=25.7090,-80.3198,25.8558,-80.1395 --boundary-geojson=data/boundaries/miami_place_boundary.geojson --replace-source",
    "normalize:osm:pbf:miami-dade:boundary:dry-run": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami-Dade --state=FL --boundary-geojson=data/boundaries/miami_dade_county_boundary.geojson --dry-run",
    "normalize:osm:pbf:miami-dade:boundary": "node apps/backend/scripts/normalize_osm_raw_parking_to_db.mjs --city=Miami-Dade --state=FL --boundary-geojson=data/boundaries/miami_dade_county_boundary.geojson --replace-source",
    "normalize:street-parking": "tsx apps/backend/scripts/normalize_street_parking.ts",
    "normalize:street-parking:db": "tsx apps/backend/scripts/normalize_street_parking.ts --db",
    "audit:parking-geometry:miami": "tsx apps/backend/scripts/audit_miami_parking_geometry.ts",
    "audit:parking-geometry:miami:refresh": "tsx apps/backend/scripts/audit_miami_parking_geometry.ts --refresh-osm",
    "derive:heuristics": "tsx apps/backend/scripts/derive_parking_heuristics.ts",
    "derive:heuristics:db": "tsx apps/backend/scripts/derive_parking_heuristics.ts --db",
    "research:manifests": "node apps/backend/scripts/generate_research_city_manifests.mjs",
    "research:validate": "node apps/backend/scripts/validate_research_manifests.mjs",
    "research:inspect:socrata": "tsx apps/backend/scripts/inspect_socrata_source.ts",
    "research:inspect:socrata:db": "tsx apps/backend/scripts/inspect_socrata_source.ts --db",
    "research:inspect:socrata:sf": "tsx apps/backend/scripts/inspect_socrata_source.ts --manifest=data/research/cities/san-francisco.ca.json",
    "research:inspect:socrata:sf:db": "tsx apps/backend/scripts/inspect_socrata_source.ts --db --manifest=data/research/cities/san-francisco.ca.json",
    "research:inspect:socrata:benchmarks": "tsx apps/backend/scripts/inspect_socrata_source.ts --manifest=data/research/cities/san-francisco.ca.json && tsx apps/backend/scripts/inspect_socrata_source.ts --manifest=data/research/cities/new-york-city.ny.json && tsx apps/backend/scripts/inspect_socrata_source.ts --manifest=data/research/cities/seattle.wa.json && tsx apps/backend/scripts/inspect_socrata_source.ts --manifest=data/research/cities/los-angeles.ca.json",
    "research:inspect:socrata:benchmarks:db": "tsx apps/backend/scripts/inspect_socrata_source.ts --db --manifest=data/research/cities/san-francisco.ca.json && tsx apps/backend/scripts/inspect_socrata_source.ts --db --manifest=data/research/cities/new-york-city.ny.json && tsx apps/backend/scripts/inspect_socrata_source.ts --db --manifest=data/research/cities/seattle.wa.json && tsx apps/backend/scripts/inspect_socrata_source.ts --db --manifest=data/research/cities/los-angeles.ca.json",
    "research:inspect:arcgis": "node apps/backend/scripts/inspect_arcgis_source.mjs",
    "research:inspect:arcgis:db": "node apps/backend/scripts/inspect_arcgis_source.mjs --db",
    "research:inspect:arcgis:benchmarks": "node apps/backend/scripts/inspect_arcgis_source.mjs --manifest=data/research/cities/seattle.wa.json",
    "research:inspect:arcgis:benchmarks:db": "node apps/backend/scripts/inspect_arcgis_source.mjs --db --manifest=data/research/cities/seattle.wa.json",
    "research:inspect:ckan": "node apps/backend/scripts/inspect_ckan_source.mjs",
    "connector:socrata:dry-run": "tsx apps/backend/scripts/run_socrata_connector.ts --dry-run --limit=2",
    "connector:arcgis:dry-run": "tsx apps/backend/scripts/run_arcgis_connector.ts --dry-run --limit=2",
    "connector:ckan:dry-run": "tsx apps/backend/scripts/run_ckan_connector.ts --dry-run --limit=2 --query=parking",
    "enrich:premium:dry-run": "tsx apps/backend/scripts/run_premium_enrichment.ts --dry-run --limit=5",
    "connector:socrata:import": "tsx apps/backend/scripts/run_socrata_connector.ts --import",
    "connector:arcgis:import": "tsx apps/backend/scripts/run_arcgis_connector.ts --import",
    "connector:ckan:import": "tsx apps/backend/scripts/run_ckan_connector.ts --import",
    "enrich:premium:import": "tsx apps/backend/scripts/run_premium_enrichment.ts --import",
    "research:fetch:url": "node apps/backend/scripts/fetch_research_url.mjs",
    "research:gap-workflows": "node apps/backend/scripts/generate_phase6_gap_workflows.mjs",
    "research:phase6": "npm run research:manifests && npm run research:gap-workflows && npm run research:validate && npm run research:inspect:socrata:benchmarks && npm run research:inspect:arcgis:benchmarks",
    "research:worker:v0": "node apps/backend/scripts/run_phase6_research_worker.mjs",
    "research:codex": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend/scripts/codex_research.ps1",
    "test": "vitest run tests",
    "tiles:build": "node apps/backend/scripts/build_tiles.mjs",
    "tiles:dry-run": "node apps/backend/scripts/build_tiles.mjs --dry-run",
    "test:street-parking": "vitest run tests/lib/street-parking",
    "frontend:dev": "next dev apps/frontend",
    "frontend:dev:public": "next dev apps/frontend -H 0.0.0.0 -p 3000",
    "frontend:build": "next build apps/frontend",
    "frontend:start": "next start apps/frontend",
    "frontend:start:public": "next start apps/frontend -H 0.0.0.0 -p 3000",
    "zrok:enable": "node apps/backend/scripts/zrok_enable.mjs",
    "share:zrok": "node apps/backend/scripts/zrok_share.mjs public",
    "share:zrok:private": "node apps/backend/scripts/zrok_share.mjs private",
    "tunnel:zrok": "node apps/backend/scripts/zrok_share.mjs public",
    "tunnel:zrok:private": "node apps/backend/scripts/zrok_share.mjs private"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@xmldom/xmldom": "^0.9.10",
    "lodash": "^4.18.1",
    "maplibre-gl": "^4.7.1",
    "next": "^15.1.0",
    "node-cron": "^4.2.1",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "postcss": "^8.5.10"
  }
}
